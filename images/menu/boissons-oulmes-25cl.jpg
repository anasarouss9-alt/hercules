 .apptile-smart-app-banner *::before,
 .apptile-smart-app-banner *::after {
    box-sizing: content-box;
  }
 .apptile-smart-app-banner p,
 .apptile-smart-app-banner h5,
 .apptile-smart-app-banner h4,
 .apptile-smart-app-banner h3 {
    margin: 0;
    padding: 0;
  }
 .mobile-app-banner {
    padding: 4px 10px;
    display: none;
    flex-direction: row;
    gap: 4px;
    background: #fff;
    align-items: center;
