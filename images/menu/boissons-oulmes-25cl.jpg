</section><section id="shopify-section-template--27329382121788__17929588710e1aa8a9" class="shopify-section section section-apps"><div class=" container section-content"><div id="shopify-block-AaC9sTGliTTBSTGY1V__ss_product_expiration_dates_index_fKz8gg" class="shopify-block shopify-app-block">









<div id="ss-AaC9sTGliTTBSTGY1V__ss_product_expiration_dates_index_fKz8gg">
  <!-- BEGIN app snippet: product-expiration-dates -->














  

  <div class="ss-product-expiration-dates">
    
      <span class="ss-product-expiration-dates__prefix"></span>
      <span class="ss-product-expiration-dates__time"></span>
      <span class="ss-product-expiration-dates__suffix"></span>
    

    <span class="ss-product-expiration-dates__batch"></span>

    
  </div>

  <script>
   window.SS = window.SS || {};
   window.SS.product = {
     defaultVariant: ''+52924501754172,
     variants: [{
           id: 52924501754172,
           title: "Default Title",
           option1: "Default Title",
           }]
   };

   window.SS.expirationDates = {
     batchPrefix: "Best DLC",
     batchSuffix: "",variantTemplate: "[variant_title] - [expires]",};

   window.SS.init = function(options) {
    console.log('Initializing Product Expiration Dates app');
    this.loaded = true;

    options = options || {};

    function error(message) {
      console.error('Product Expiration Dates app: ' + message);
    }

    function showOrHideDate(variantId) {
      const cfg = SS.expirationDates[''+variantId], showDiscount = false, discountText = "";

      // Put this elsehwere
      if(showDiscount && discountText) {
        const discountContainer = document.querySelector('.ss-product-expiration-dates-discount');
        if(discountContainer)
          discountContainer.style.display = cfg && cfg.discount_in_progress ? 'block' : 'none';
      }

      if(!cfg || cfg.hide) {
        expiresContainer.style.display = 'none';
        return;
      }

      expiresContainer.style.display = 'block';

      const timeEl = document.querySelector('.ss-product-expiration-dates__time');
      if(timeEl) timeEl.textContent = cfg.time;

      const prefixEl = document.querySelector('.ss-product-expiration-dates__prefix');
      if(prefixEl && SS.expirationDates.batchPrefix)
        prefixEl.innerHTML = SS.expirationDates.batchPrefix;

      const suffixEl = document.querySelector('.ss-product-expiration-dates__suffix');
      if(suffixEl && SS.expirationDates.batchSuffix)
        suffixEl.innerHTML = SS.expirationDates.batchSuffix;

      if(false) {
        const batchContainer = document.querySelector('.ss-product-expiration-dates__batch'),
              batchNumber = document.querySelector('.ss-product-expiration-dates__batch-number');

        if(!cfg.batch) {
          batchContainer.style.display = 'none';
        }
        else {
          if(batchNumber) batchNumber.textContent = cfg.batch;
          batchContainer.style.display = '';
        }
      }
    }

    function variantSelected(variantId) {
      // Delay to ensure variant param has changed
      setTimeout(function () {
        showOrHideDate(variantId);
      }, 750);
    }

    function applyVariantTemplate(variables) {
      return SS.expirationDates.variantTemplate.replace(/\[\s*([\w.]+)\s*\]/g, (match, key) => (key in variables) ? variables[key] : '');
    }

   function showForVariants(variants) {
     if(!SS.expirationDates.variantTemplate) return;

      // TODO: use within and consolidate with other code
      const snippet = variants.map(variant => {
        const config = SS.expirationDates[''+variant.id], variables = {
          variant_title: `<span class="ss-product-expiration-dates__variant">${variant.title}</span>`,
          expires: `<span class="ss-product-expiration-dates__time">${config.time}</span>`
        }

        if(config.batch)
          variables.batch_number = `<span class="ss-product-expiration-dates__batch-number">${config.batch}</span>`;

        return applyVariantTemplate(variables)
      });

     const root = document.querySelector('.ss-product-expiration-dates');
     root.style.display = '';  // May be hidden
     root.querySelectorAll('.ss-product-expiration-dates__time, .ss-product-expiration-dates__suffix, .ss-product-expiration-dates__batch').forEach(el => el.remove());

     if(SS.expirationDates.batchPrefix)
       document.querySelector('.ss-product-expiration-dates__prefix').innerHTML = SS.expirationDates.batchPrefix;

     root.insertAdjacentHTML('beforeend', `<br>${snippet.join('<br>')}`);
   }

     // Could have multiple root elements???
    var root = document,
        expiresContainer = document.querySelector('.ss-product-expiration-dates'),
        cartFormSelector = 'form[action="/cart/add"]',
        variantSelector = `${cartFormSelector} select, ${cartFormSelector} input, ${cartFormSelector} label`;

    if(!expiresContainer) {
      error('Cannot find expiration date container element');
      return;
    }

    showOrHideDate(SS.product.defaultVariant);

    if(SS.product.variants.length === 1 && SS.product.variants[0].title === 'Default Title') {
      return;
    }

    if(options.variantSelector)
      variantSelector = options.variantSelector;

    if(options.container) {
      try {
        root = document.querySelector(options.container);
        if(!root) {
          error(`Variant container '${options.container}' not found`);
          return;
        }
      }
      catch(e) {
        error(`Invalid variant container '${options.container}' (${e.message})`);
        return;
      }
    }

    if(!window.location.pathname.includes('/products/')) {
      const variants = SS.product.variants.filter(variant => SS.expirationDates[''+variant.id] && !SS.expirationDates[''+variant.id].hide);
      if(variants.length) showForVariants(variants);
    }
     else {
       document.addEventListener('DOMContentLoaded', () => {
        let lastVariantId = null;
        new MutationObserver(_ => {
          // Can't rely on location.href because this may be called before it changes so we do this on every change
          const id = new URL(location.href).searchParams.get('variant');
          if(id && id !== lastVariantId) {
            lastVariantId = id;
            variantSelected(id);
          }
        }).observe(document, {subtree: true, childList: true});
       });
     }
   };

   SS.init();
  </script>

<!-- END app snippet -->
</div>

<style>
 
 #ss-AaC9sTGliTTBSTGY1V__ss_product_expiration_dates_index_fKz8gg .ss-product-expiration-dates {
     text-align: left;
 }
 #ss-AaC9sTGliTTBSTGY1V__ss_product_expiration_dates_index_fKz8gg .ss-product-expiration-dates-discount {
     text-align: left;
 }
</style>


</div>
