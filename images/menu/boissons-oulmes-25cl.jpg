    top: 4px;
  }
 .appDetails,
 .dialogHeading {
    flex-direction: column;
    flex: auto;
    padding: 0 6px;
  }
 #apptile-qr-code {
    margin-top: 10px;
    padding-top: 10px;
    border-top: solid 0.1px;
    justify-content: center;
    display: flex;
  }
  #apptile-qr-code image{
    clip-path: inset(0% round 3px);
  }
 .appIcon {
    width: 45px;
    height: 45px;
    padding: 3px 2px;
  }
 .appDetails h5 {
    font-family: Helvetica;
    font-weight: bold;
    font-size: 10px !important;
    line-height: 1.2 !important;
    letter-spacing: 1px;
    margin-bottom: 1px;
    word-wrap: break-word;
  }
 .appDetails p {
    font-family: Helvetica;
    font-weight: 400;
    font-size: 10px !important;
    line-height: 1.2 !important;
    letter-spacing: 0.4px;
    word-wrap: break-word;
    word-break: break-all;
  }
 
 /* App rating row (mobile only, below description). Hidden by default;
    JS toggles display:flex when config.mobileBanner.showAppRating is true.
    Renders as: [5 yellow-star row with partial fill] (12345)
    Star fill is achieved by stacking two ★★★★★ layers — a gray base and a
    yellow foreground clipped to a percentage-width equal to (rating / 5). */
 .appDetails .appRatingRow {
    display: none;
    align-items: center;
    gap: 4px;
    margin-top: 1px;
    font-family: Helvetica;
    font-weight: 400;
    font-size: 12px !important;
    line-height: 1.2 !important;
    letter-spacing: 0.2px;
    color: #7a7a7a;
  }
 .appDetails .appRatingRow .starsWrap {
    position: relative;
    display: inline-block;
    line-height: 1;
    font-size: 10px !important;
    line-height: 1.2 !important;
    letter-spacing: 1px;
  }
 .appDetails .appRatingRow .starsBg,
 .appDetails .appRatingRow .starsFg {
    display: inline-block;
    white-space: nowrap;
  }
 .appDetails .appRatingRow .starsBg {
    color: #E4E5E9;
  }
 .appDetails .appRatingRow .starsFg {
    position: absolute;
    left: 0;
    top: 0;
    overflow: hidden;
    color: #F7BA00;
    width: 0%;
  }
 .appDetails .appRatingRow .votes {
    color: #7a7a7a;
